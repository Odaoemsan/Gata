
{
  "entities": {
    "User": {
      "title": "User",
      "description": "Represents a user of the application.",
      "type": "object",
      "properties": {
        "displayName": {
          "type": "string",
          "description": "The user's full name."
        },
        "username": {
          "type": "string",
          "description": "The user's unique username."
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "The user's email address."
        },
        "balance": {
          "type": "number",
          "description": "The user's current account balance."
        },
        "totalDeposits": {
          "type": "number",
          "description": "The total amount of money deposited by the user."
        },
        "totalWithdrawals": {
          "type": "number",
          "description": "The total amount of money withdrawn by the user."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "The date and time the user was created."
        },
        "referredBy": {
          "type": "string",
          "description": "The username of the user who referred this user."
        },
        "referralCommissions": {
            "type": "number",
            "description": "Total commissions earned from referrals."
        }
      },
      "required": ["displayName", "username", "email", "balance", "totalDeposits", "totalWithdrawals", "referralCommissions"]
    },
    "InvestmentPlan": {
      "title": "Investment Plan",
      "description": "Represents an investment plan.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "The name of the investment plan."
        },
        "dailyProfit": {
          "type": "number",
          "description": "The daily profit percentage."
        },
        "duration": {
          "type": "number",
          "description": "The duration of the plan in days."
        },
        "minMax": {
          "type": "string",
          "description": "The minimum and maximum investment amount."
        }
      },
      "required": ["name", "dailyProfit", "duration", "minMax"]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "Represents a financial transaction.",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": ["deposit", "withdrawal", "commission", "task_reward"],
          "description": "The type of transaction."
        },
        "amount": {
          "type": "number",
          "description": "The amount of the transaction."
        },
        "date": {
          "type": "string",
          "format": "date-time",
          "description": "The date and time of the transaction."
        },
        "status": {
            "type": "string",
            "enum": ["pending", "completed", "failed"],
            "description": "The status of the transaction."
        },
        "walletAddress": {
          "type": "string",
          "description": "The crypto wallet address for withdrawals."
        },
        "transactionId": {
          "type": "string",
          "description": "The blockchain transaction ID for deposit verification."
        },
        "userId": {
          "type": "string",
          "description": "The ID of the user who initiated the transaction."
        },
        "username": {
          "type": "string",
          "description": "The username of the user for admin convenience."
        },
        "userDisplayName": {
          "type": "string",
          "description": "The display name of the user for admin convenience."
        },
        "userEmail": {
          "type": "string",
          "description": "The email of the user for admin convenience."
        }
      },
      "required": ["type", "amount", "date", "status", "userId"]
    },
    "ActiveInvestment": {
      "title": "Active Investment",
      "description": "Represents an active investment by a user.",
      "type": "object",
      "properties": {
        "planId": {
          "type": "string",
          "description": "The ID of the investment plan."
        },
        "planName": {
          "type": "string",
          "description": "The name of the investment plan."
        },
        "amount": {
          "type": "number",
          "description": "The amount invested."
        },
        "startDate": {
          "type": "string",
          "format": "date-time",
          "description": "The start date of the investment."
        },
        "endDate": {
          "type": "string",
          "format": "date-time",
          "description": "The end date of the investment."
        },
        "status": {
            "type": "string",
            "enum": ["active", "completed"],
            "description": "The status of the investment."
        }
      },
      "required": ["planId", "planName", "amount", "startDate", "endDate", "status"]
    },
    "Rank": {
      "title": "Rank",
      "description": "Represents a user's referral rank.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "The name of the rank (e.g., Bronze, Silver, Gold)."
        },
        "requiredInvestment": {
          "type": "number",
          "description": "The total team investment required to achieve this rank."
        },
        "commissionRate": {
          "type": "number",
          "description": "The commission rate percentage for this rank."
        }
      },
      "required": ["name", "requiredInvestment", "commissionRate"]
    },
    "Task": {
      "title": "Task",
      "description": "Represents a task a user can complete for a reward.",
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "description": "The title of the task."
        },
        "description": {
          "type": "string",
          "description": "A detailed description of the task."
        },
        "reward": {
          "type": "number",
          "description": "The monetary reward for completing the task."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "The date the task was created."
        }
      },
      "required": ["title", "description", "reward", "createdAt"]
    },
    "TaskSubmission": {
      "title": "Task Submission",
      "description": "Represents a user's submission for a task.",
      "type": "object",
      "properties": {
        "taskId": {
          "type": "string",
          "description": "The ID of the submitted task."
        },
        "taskTitle": {
          "type": "string",
          "description": "The title of the submitted task."
        },
        "userId": {
          "type": "string",
          "description": "The ID of the user who submitted the task."
        },
        "username": {
          "type": "string",
          "description": "The username of the user."
        },
        "userDisplayName": {
          "type": "string",
          "description": "The display name of the user."
        },
        "userEmail": {
          "type": "string",
          "description": "The email of the user."
        },
        "submissionLink": {
          "type": "string",
          "description": "The link provided by the user as proof of completion."
        },
        "status": {
          "type": "string",
          "enum": ["pending", "approved", "rejected"],
          "description": "The status of the submission."
        },
        "submittedAt": {
          "type": "string",
          "format": "date-time",
          "description": "The date the submission was made."
        }
      },
      "required": ["taskId", "taskTitle", "userId", "username", "userDisplayName", "userEmail", "submissionLink", "status", "submittedAt"]
    }
  },
  "auth": {
    "providers": ["password"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Stores user profile information."
    },
    "/investmentPlans/{planId}": {
      "schema": { "$ref": "#/entities/InvestmentPlan" },
      "description": "Stores the available investment plans."
    },
    "/users/{userId}/transactions/{transactionId}": {
      "schema": { "$ref": "#/entities/Transaction" },
      "description": "Stores user financial transactions."
    },
    "/users/{userId}/activeInvestments/{investmentId}": {
      "schema": { "$ref": "#/entities/ActiveInvestment" },
      "description": "Stores a user's active investments."
    },
    "/ranks/{rankId}": {
      "schema": { "$ref": "#/entities/Rank" },
      "description": "Stores the referral ranks and their requirements."
    },
    "/tasks/{taskId}": {
        "schema": { "$ref": "#/entities/Task" },
        "description": "Stores available tasks for users."
    },
    "/taskSubmissions/{submissionId}": {
        "schema": { "$ref": "#/entities/TaskSubmission" },
        "description": "Stores user submissions for tasks."
    }
  }
}
