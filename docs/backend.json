
{
  "entities": {
    "User": {
      "title": "User",
      "description": "Represents a user of the application.",
      "type": "object",
      "properties": {
        "displayName": {
          "type": "string",
          "description": "The user's full name."
        },
        "username": {
          "type": "string",
          "description": "The user's unique username."
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "The user's email address."
        },
        "balance": {
          "type": "number",
          "description": "The user's current account balance."
        },
        "totalDeposits": {
          "type": "number",
          "description": "The total amount of money deposited by the user."
        },
        "totalWithdrawals": {
          "type": "number",
          "description": "The total amount of money withdrawn by the user."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "The date and time the user was created."
        },
        "referredBy": {
          "type": "string",
          "description": "The username of the user who referred this user."
        },
        "referralCommissions": {
            "type": "number",
            "description": "Total commissions earned from referrals."
        }
      },
      "required": ["displayName", "username", "email", "balance", "totalDeposits", "totalWithdrawals", "referralCommissions"]
    },
    "InvestmentPlan": {
      "title": "Investment Plan",
      "description": "Represents an investment plan.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "The name of the investment plan."
        },
        "dailyProfit": {
          "type": "number",
          "description": "The daily profit percentage."
        },
        "duration": {
          "type": "number",
          "description": "The duration of the plan in days."
        },
        "minMax": {
          "type": "string",
          "description": "The minimum and maximum investment amount."
        }
      },
      "required": ["name", "dailyProfit", "duration", "minMax"]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "Represents a financial transaction.",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": ["deposit", "withdrawal", "commission"],
          "description": "The type of transaction."
        },
        "amount": {
          "type": "number",
          "description": "The amount of the transaction."
        },
        "date": {
          "type": "string",
          "format": "date-time",
          "description": "The date and time of the transaction."
        },
        "status": {
            "type": "string",
            "enum": ["pending", "completed", "failed"],
            "description": "The status of the transaction."
        },
        "walletAddress": {
          "type": "string",
          "description": "The crypto wallet address for withdrawals."
        },
        "transactionId": {
          "type": "string",
          "description": "The blockchain transaction ID for deposit verification."
        }
      },
      "required": ["type", "amount", "date", "status"]
    },
    "ActiveInvestment": {
      "title": "Active Investment",
      "description": "Represents an active investment by a user.",
      "type": "object",
      "properties": {
        "planId": {
          "type": "string",
          "description": "The ID of the investment plan."
        },
        "planName": {
          "type": "string",
          "description": "The name of the investment plan."
        },
        "amount": {
          "type": "number",
          "description": "The amount invested."
        },
        "startDate": {
          "type": "string",
          "format": "date-time",
          "description": "The start date of the investment."
        },
        "endDate": {
          "type": "string",
          "format": "date-time",
          "description": "The end date of the investment."
        },
        "status": {
            "type": "string",
            "enum": ["active", "completed"],
            "description": "The status of the investment."
        }
      },
      "required": ["planId", "planName", "amount", "startDate", "endDate", "status"]
    }
  },
  "auth": {
    "providers": ["password"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Stores user profile information."
    },
    "/investmentPlans/{planId}": {
      "schema": { "$ref": "#/entities/InvestmentPlan" },
      "description": "Stores the available investment plans."
    },
    "/users/{userId}/transactions/{transactionId}": {
      "schema": { "$ref": "#/entities/Transaction" },
      "description": "Stores user financial transactions."
    },
    "/users/{userId}/activeInvestments/{investmentId}": {
      "schema": { "$ref": "#/entities/ActiveInvestment" },
      "description": "Stores a user's active investments."
    }
  }
}
