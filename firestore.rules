
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check for admin role via custom claims
    function isAdmin() {
      return request.auth.token.admin == true;
    }

    // Helper function to check if the user is the owner of the document
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // Users collection
    match /users/{userId} {
      // Any authenticated user can create their own profile upon signup.
      allow create: if request.auth.uid == userId
                    && request.resource.data.displayName is string
                    && request.resource.data.username is string
                    && request.resource.data.email == request.auth.token.email
                    && request.resource.data.balance == 0
                    && request.resource.data.totalDeposits == 0
                    && request.resource.data.totalWithdrawals == 0
                    && request.resource.data.referralCommissions == 0
                    && (!('referredBy' in request.resource.data) || request.resource.data.referredBy is string);
      
      // Only the owner or an admin can read the profile.
      allow get: if isOwner(userId) || isAdmin();
      
      // Admins can update any field. 
      // Users can update their own profile.
      allow update: if isAdmin() || isOwner(userId);

      // No one can delete a user profile for now.
      allow delete: if false;

      // Transactions subcollection
      match /transactions/{transactionId} {
        // The owner can list and read their own transactions. Admins can read any.
        allow list, get: if isOwner(userId) || isAdmin();

        // The owner can create transactions with valid data.
        allow create: if isOwner(userId)
                      && (
                        // Deposit transaction validation
                        (request.resource.data.type == 'deposit'
                          && request.resource.data.amount is number
                          && request.resource.data.status == 'pending'
                          && request.resource.data.date == request.time
                          && request.resource.data.transactionId is string
                          && request.resource.data.userId == userId
                          && request.resource.data.keys().hasAll(['type', 'amount', 'status', 'date', 'transactionId', 'userId', 'username', 'userDisplayName', 'userEmail'])) ||
                        // Withdrawal transaction validation
                        (request.resource.data.type == 'withdrawal'
                          && request.resource.data.amount is number
                          && request.resource.data.walletAddress is string
                          && request.resource.data.status == 'pending'
                          && request.resource.data.date == request.time) ||
                        // Task reward transaction validation (only by admin logic)
                        (request.resource.data.type == 'task_reward' 
                          && isAdmin() // This check happens in a transaction run by an admin
                          && request.resource.data.amount is number
                          && request.resource.data.status == 'completed'
                          && request.resource.data.date == request.time
                          && request.resource.data.userId == userId
                          && request.resource.data.keys().hasAll(['type', 'amount', 'status', 'date', 'userId', 'username', 'userDisplayName', 'userEmail']))
                      );
        
        // Admins can update status, but users cannot.
        allow update: if isAdmin();

        // No one can delete transactions for now to preserve history.
        allow delete: if false;
      }

      // Active Investments subcollection
      match /activeInvestments/{investmentId} {
        // Owner can read their own investments. Admins can read any.
        allow list, get: if isOwner(userId) || isAdmin();

        // Owner can create a new investment if the data is valid
        allow create: if isOwner(userId) 
                      && request.resource.data.planId is string
                      && request.resource.data.planName is string
                      && request.resource.data.amount is number
                      && request.resource.data.amount > 0
                      && request.resource.data.status == 'active'
                      && request.resource.data.startDate == request.time;
        
        // No updates or deletes for now to preserve investment record
        allow update, delete: if false;
      }
    }

    // Investment Plans collection
    match /investmentPlans/{planId} {
      // Allow public read access to investment plans for all authenticated users.
      allow get, list: if request.auth != null;

      // Only admins can create, update, or delete investment plans.
      allow write: if isAdmin();
    }

    // Ranks collection
    match /ranks/{rankId} {
      // Allow public read access to ranks for all authenticated users.
      allow get, list: if request.auth != null;
      // Only admins can create, update, or delete ranks.
      allow write: if isAdmin();
    }

    // Tasks collection
    match /tasks/{taskId} {
        // Authenticated users can read tasks
        allow get, list: if request.auth != null;
        // Only admins can create, update, or delete tasks
        allow write: if isAdmin();
    }
    
    // Task Submissions collection
    match /taskSubmissions/{submissionId} {
        // Users can create their own submissions
        allow create: if isOwner(request.resource.data.userId)
                      && request.resource.data.status == 'pending'
                      && request.resource.data.submittedAt == request.time;
        
        // Admins can read all submissions
        allow get, list: if isAdmin();
        
        // Admins can update the status of a submission
        allow update: if isAdmin() && request.resource.data.status != resource.data.status;
        
        // No one can delete submissions
        allow delete: if false;
    }
  }
}
