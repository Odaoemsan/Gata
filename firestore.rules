
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check for admin role
    function isAdmin() {
      return request.auth.token.admin == true;
    }

    // Helper function to check if the user is the owner of the document
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // Users collection
    match /users/{userId} {
      // Any authenticated user can create their own profile upon signup.
      allow create: if request.auth != null && isOwner(userId)
                    && request.resource.data.displayName is string
                    && request.resource.data.username is string
                    && request.resource.data.email == request.auth.token.email
                    && request.resource.data.balance == 0
                    && request.resource.data.totalDeposits == 0
                    && request.resource.data.totalWithdrawals == 0;
      
      // Only the owner or an admin can read the profile.
      allow get: if isOwner(userId) || isAdmin();
      
      // Admins can update any field. 
      // Users can update their balance only when making an investment, 
      // ensuring the new balance is correctly calculated.
      allow update: if isAdmin() || 
                     (isOwner(userId) && 
                      'balance' in request.resource.data &&
                      request.resource.data.balance == resource.data.balance - request.resource.data.investmentAmount &&
                      request.resource.data.keys().hasOnly(['balance']));

      // No one can delete a user profile for now.
      allow delete: if false;

      // Transactions subcollection
      match /transactions/{transactionId} {
        // The owner can list and read their own transactions.
        allow list, get: if isOwner(userId);

        // The owner can create transactions with valid data.
        allow create: if isOwner(userId)
                      && (
                        // Deposit transaction validation
                        (request.resource.data.type == 'deposit'
                          && request.resource.data.amount is number
                          && request.resource.data.status == 'pending'
                          && request.resource.data.date == request.time
                          && request.resource.data.keys().hasAll(['type', 'amount', 'status', 'date'])) ||
                        // Withdrawal transaction validation
                        (request.resource.data.type == 'withdrawal'
                          && request.resource.data.amount is number
                          && request.resource.data.walletAddress is string
                          && request.resource.data.status == 'pending'
                          && request.resource.data.date == request.time
                          && request.resource.data.keys().hasAll(['type', 'amount', 'walletAddress', 'status', 'date']))
                      );
        
        // Admins can update status, but users cannot.
        allow update: if isAdmin();

        // No one can delete transactions for now to preserve history.
        allow delete: if false;
      }

      // Active Investments subcollection
      match /activeInvestments/{investmentId} {
        // Owner can read their own investments
        allow list, get: if isOwner(userId);

        // Owner can create a new investment if the data is valid
        allow create: if isOwner(userId) 
                      && request.resource.data.planId is string
                      && request.resource.data.planName is string
                      && request.resource.data.amount is number
                      && request.resource.data.amount > 0
                      && request.resource.data.status == 'active'
                      && request.resource.data.startDate == request.time;
        
        // No updates or deletes for now to preserve investment record
        allow update, delete: if false;
      }
    }

    // Investment Plans collection
    match /investmentPlans/{planId} {
      // Any authenticated user can read the investment plans.
      allow get, list: if request.auth != null;

      // Only admins can create, update, or delete investment plans.
      allow write: if isAdmin();
    }
  }
}
