
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check for admin role via email
    function isAdmin() {
      return request.auth.token.email == 'odae.oth@gmail.com';
    }

    // Helper function to check if the user is the owner of the document
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Users collection
    match /users/{userId} {
      // Any authenticated user can create their own profile upon signup.
      allow create: if request.auth.uid == userId
                    && request.resource.data.displayName is string
                    && request.resource.data.username is string
                    && request.resource.data.email == request.auth.token.email
                    && request.resource.data.balance == 0
                    && request.resource.data.totalDeposits == 0
                    && request.resource.data.totalWithdrawals == 0
                    && request.resource.data.referralCommissions == 0
                    && (!('referredBy' in request.resource.data) || request.resource.data.referredBy is string);
      
      // Only the owner or an admin can read the profile.
      allow get: if isOwner(userId) || isAdmin();
      
      // Admins can update displayName, username, and balance. 
      // Users can only update their own displayName and username.
      allow update: if (isAdmin() && request.resource.data.keys().hasAll(['displayName', 'username', 'balance'])) || 
                     (isOwner(userId) && request.resource.data.keys().hasOnly(['displayName', 'username']));

      // No one can delete a user profile for now.
      allow delete: if false;

      // Transactions subcollection (permanent records)
      match /transactions/{transactionId} {
        // The owner can read their own transactions. Admins can read any.
        allow get, list: if isOwner(userId) || isAdmin();

        // No direct creation by users. Admins create these when processing requests.
        allow create: if isAdmin();
        
        // No updates allowed to preserve history
        allow update: if false;
      }

      // Active Investments subcollection
      match /activeInvestments/{investmentId} {
        // Owner can read their own investments. Admins can read any.
        allow list, get: if isOwner(userId) || isAdmin();

        // Owner can create a new investment if the data is valid
        allow create: if isOwner(userId) 
                      && request.resource.data.planId is string
                      && request.resource.data.planName is string
                      && request.resource.data.amount is number
                      && request.resource.data.amount > 0
                      && request.resource.data.status == 'active'
                      && request.resource.data.startDate == request.time;
        
        // No updates or deletes for now to preserve investment record
        allow update, delete: if false;
      }
    }
    
    // Pending Deposits collection
    match /pendingDeposits/{depositId} {
        // Users can create their own deposit requests with valid data.
        allow create: if isOwner(request.resource.data.userId)
                      && request.resource.data.type == 'deposit'
                      && request.resource.data.amount is number && request.resource.data.amount > 0
                      && request.resource.data.transactionId is string && request.resource.data.transactionId != ''
                      && request.resource.data.date == request.time
                      && request.resource.data.username is string
                      && request.resource.data.userDisplayName is string
                      && request.resource.data.userEmail is string
                      && request.resource.data.keys().hasAll(['type', 'amount', 'date', 'transactionId', 'userId', 'username', 'userDisplayName', 'userEmail']);
                      
        // Admins can read and delete (process) requests
        allow get, list, delete: if isAdmin();
        allow update: if false; // No updates allowed to pending requests
    }
    
    // Pending Withdrawals collection
    match /pendingWithdrawals/{withdrawalId} {
      // Users can create their own withdrawal requests
      allow create: if isOwner(request.resource.data.userId);
      // Admins can read and delete (process) requests
      allow get, list, delete: if isAdmin();
    }

    // Investment Plans collection
    match /investmentPlans/{planId} {
      // Allow public read access to investment plans for all authenticated users.
      allow get, list: if request.auth != null;

      // Only admins can create, update, or delete investment plans.
      allow write: if isAdmin();
    }

    // Ranks collection
    match /ranks/{rankId} {
      // Allow public read access to ranks for all authenticated users.
      allow get, list: if request.auth != null;
      // Only admins can create, update, or delete ranks.
      allow write: if isAdmin();
    }

    // Tasks collection
    match /tasks/{taskId} {
        // Authenticated users can read tasks
        allow get, list: if request.auth != null;
        // Only admins can create, update, or delete tasks
        allow write: if isAdmin();
    }
    
    // Task Submissions collection
    match /taskSubmissions/{submissionId} {
        // Users can create their own submissions
        allow create: if isOwner(request.resource.data.userId)
                      && request.resource.data.status == 'pending'
                      && request.resource.data.submittedAt == request.time
                      && request.resource.data.username is string
                      && request.resource.data.userDisplayName is string
                      && request.resource.data.userEmail is string
                      && request.resource.data.submissionLink is string;
        
        // Admins can read all submissions
        allow get, list: if isAdmin();
        
        // Admins can update the status of a submission
        allow update: if isAdmin() && request.resource.data.status != resource.data.status;
        
        // No one can delete submissions
        allow delete: if false;
    }
  }
}
