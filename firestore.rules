rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check for admin role via email
    function isAdmin() {
      return request.auth.token.email == 'odae.oth@gmail.com';
    }

    // Helper function to check if the user is the owner of the document
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }
    
    // Global App Settings
    match /settings/global {
      allow get: if request.auth != null; // Authenticated users can read settings
      allow write: if isAdmin(); // Only admin can change settings
    }

    // Users collection
    match /users/{userId} {
      // Allow creation only if the user is the owner.
      allow create: if isOwner(userId)
                    && request.resource.data.displayName is string
                    && request.resource.data.username is string
                    && request.resource.data.email == request.auth.token.email
                    && request.resource.data.referralCode is string && request.resource.data.referralCode.size() == 7
                    && (!('referredBy' in request.resource.data) || request.resource.data.referredBy is string);
      
      allow get: if isOwner(userId) || isAdmin();

      // Allow a user to list other users ONLY if they are querying by their own referral code
      allow list: if request.auth != null &&
                   request.query.where[0][0] == 'referredBy' &&
                   request.query.where[0][2] == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.referralCode;
      
      allow update: if (isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'username', 'balance', 'totalDeposits', 'totalWithdrawals', 'referralCommissions'])) || 
                     (isOwner(userId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'username']));

      allow delete: if false;

      // Transactions subcollection (permanent records)
      match /transactions/{transactionId} {
        allow get, list: if isOwner(userId) || isAdmin();
        allow create: if isAdmin() || isOwner(userId); // Owner can create (for withdrawals), Admin creates for deposits/rewards
        allow update, delete: if false;
      }

      // Active Investments subcollection
      match /activeInvestments/{investmentId} {
        allow list, get: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId) 
                      && request.resource.data.planId is string
                      && request.resource.data.planName is string
                      && request.resource.data.amount is number
                      && request.resource.data.amount > 0
                      && request.resource.data.status == 'active'
                      && request.resource.data.startDate == request.time;
        allow update, delete: if false;
      }
    }

    // This collection is a lookup table to enforce username uniqueness.
    // It should be kept in sync with a Cloud Function.
    // Disabling client-side checks for now.
    match /users_by_username/{username} {
        allow read, write: if false; 
        allow create: if false;
    }
    
    // Pending Deposits collection
    match /pendingDeposits/{depositId} {
        allow create: if isOwner(request.resource.data.userId)
                      && request.resource.data.type == 'deposit'
                      && request.resource.data.amount is number && request.resource.data.amount > 0
                      && request.resource.data.transactionId is string && request.resource.data.transactionId != ''
                      && request.resource.data.date == request.time
                      && request.resource.data.username is string
                      && request.resource.data.userDisplayName is string
                      && request.resource.data.userEmail is string;
                      
        allow get, list, delete: if isAdmin();
        allow update: if false;
    }
    
    // Pending Withdrawals collection
    match /pendingWithdrawals/{withdrawalId} {
        allow create: if isOwner(request.resource.data.userId)
                      && request.resource.data.type == 'withdrawal'
                      && request.resource.data.amount is number && request.resource.data.amount > 0
                      && request.resource.data.walletAddress is string && request.resource.data.walletAddress != ''
                      && request.resource.data.date == request.time
                      && request.resource.data.username is string
                      && request.resource.data.userDisplayName is string
                      && request.resource.data.userEmail is string;

        allow get, list, delete: if isAdmin();
        allow update: if false;
    }

    // Investment Plans collection
    match /investmentPlans/{planId} {
      allow get, list: if request.auth != null;
      allow write: if isAdmin();
    }

    // Ranks collection
    match /ranks/{rankId} {
      allow get, list: if true; // Publicly readable data
      allow write: if isAdmin();
    }

    // Tasks collection
    match /tasks/{taskId} {
        allow get, list: if request.auth != null;
        allow create, update, delete: if isAdmin();
    }
    
    // Task Submissions collection
    match /taskSubmissions/{submissionId} {
        allow create: if isOwner(request.resource.data.userId)
                      && request.resource.data.status == 'pending'
                      && request.resource.data.submittedAt == request.time
                      && request.resource.data.taskId is string
                      && request.resource.data.taskTitle is string
                      && request.resource.data.username is string
                      && request.resource.data.userDisplayName is string
                      && request.resource.data.userEmail is string
                      && request.resource.data.submissionLink is string;
        
        allow get, list: if isAdmin();
        
        allow update: if isAdmin() && request.resource.data.status != resource.data.status;
        
        allow delete: if false;
    }
  }
}
